import time
import wandb
import torch
import logging
import torch.nn as nn
import torch.nn.functional as F
from torch.cuda.amp import autocast

from src.clip_loss import compute_batch_loss
from src.sam import disable_running_stats, enable_running_stats

def compute_gradient_alignment_loss(model, batch, criterion, options):
    """
    计算梯度对齐损失 - 核心功能
    """
    # 获取 backdoor 标记（保持在 CPU）
    is_backdoor = batch["is_backdoor"]  # CPU tensor
    backdoor_mask = is_backdoor.bool()
    clean_mask = ~backdoor_mask
    
    # 检查是否有足够的样本
    num_backdoor = backdoor_mask.sum().item()
    num_clean = clean_mask.sum().item()
    
    if num_backdoor == 0 or num_clean == 0:
        return None, 0.0
    
    # 在 CPU 上索引，然后移动到 GPU
    clean_input_ids = batch["input_ids"][clean_mask].to(options.device)
    clean_attention_mask = batch["attention_mask"][clean_mask].to(options.device)
    clean_pixel_values = batch["pixel_values"][clean_mask].to(options.device)
    
    backdoor_input_ids = batch["input_ids"][backdoor_mask].to(options.device)
    backdoor_attention_mask = batch["attention_mask"][backdoor_mask].to(options.device)
    backdoor_pixel_values = batch["pixel_values"][backdoor_mask].to(options.device)
    
    # 前向传播
    clean_outputs = model(
        input_ids=clean_input_ids,
        attention_mask=clean_attention_mask,
        pixel_values=clean_pixel_values
    )
    
    backdoor_outputs = model(
        input_ids=backdoor_input_ids,
        attention_mask=backdoor_attention_mask,
        pixel_values=backdoor_pixel_values
    )
    
    # 计算损失
    clean_labels = torch.arange(len(clean_outputs.logits_per_image)).to(options.device)
    clean_loss = criterion(clean_outputs.logits_per_image, clean_labels)
    
    backdoor_labels = torch.arange(len(backdoor_outputs.logits_per_image)).to(options.device)
    backdoor_loss = criterion(backdoor_outputs.logits_per_image, backdoor_labels)
    
    # 获取参数（只对视觉编码器）
    visual_params = []
    for name, param in model.named_parameters():
        if 'visual' in name and param.requires_grad:
            visual_params.append(param)
    
    if len(visual_params) == 0:
        raise ValueError("No visual parameters found!")
    
    # 计算梯度
    clean_grads = torch.autograd.grad(
        clean_loss, 
        visual_params, 
        create_graph=True, 
        retain_graph=True,
        allow_unused=False
    )
    
    backdoor_grads = torch.autograd.grad(
        backdoor_loss, 
        visual_params, 
        create_graph=True, 
        retain_graph=True,
        allow_unused=False
    )
    
    # 展平梯度向量
    clean_grad_vec = torch.cat([g.flatten() for g in clean_grads])
    backdoor_grad_vec = torch.cat([g.flatten() for g in backdoor_grads])
    
    # 计算余弦相似度
    cos_sim = F.cosine_similarity(
        clean_grad_vec.unsqueeze(0), 
        backdoor_grad_vec.unsqueeze(0)
    )
    
    # 损失 = 负余弦相似度
    alignment_loss = -cos_sim
    
    return alignment_loss, cos_sim.item()


def process_batch(model, batch, options, step):
    input_ids, attention_mask, pixel_values, is_backdoor = batch["input_ids"].to(options.device, non_blocking = True), batch["attention_mask"].to(options.device, non_blocking = True), batch["pixel_values"].to(options.device, non_blocking = True), batch["is_backdoor"].to(options.device, non_blocking = True)
    outputs = model(input_ids = input_ids, attention_mask = attention_mask, pixel_values = pixel_values)
    with torch.no_grad():
        similarity = torch.diagonal(outputs.image_embeds @ outputs.text_embeds.t())
        topmax     = int(options.remove_fraction * len(similarity))
        detect_indices = similarity.topk(topmax).indices
    num_backdoor = is_backdoor.sum().item()
    backdoor_indices = is_backdoor.nonzero()
    backdoor_indices = backdoor_indices[:,0] if len(backdoor_indices.shape) == 2 else backdoor_indices
    count = 0
    if len(backdoor_indices) > 0:
        for backdoor_index in backdoor_indices:
            count += (backdoor_index in detect_indices)
    if options.wandb and options.master:
        wandb.log({f'{options.rank}/total backdoors' : num_backdoor, 'step': step})      
        wandb.log({f'{options.rank}/correct backdoors detected' : count, 'step': step})   
    pred_backdoor_indices = torch.zeros_like(similarity).int()
    pred_backdoor_indices[detect_indices] = 1
    return outputs, pred_backdoor_indices


def train(epoch, model, data, optimizer, scheduler, scaler, options, regularizer = None):    
    dataloader = data["train"]
    if(options.distributed): dataloader.sampler.set_epoch(epoch)

    model.train()
    criterion = nn.CrossEntropyLoss().to(options.device)

    modulo = max(1, int(dataloader.num_samples / options.batch_size / 5))
    umodel = model.module if(options.distributed) else model

    start = time.time()
    
    logging.info(f"Num samples: {dataloader.num_samples}, Num_batches: {dataloader.num_batches}")
    
    # 梯度对齐参数
    lambda_align = getattr(options, 'lambda_align', 0.5)
    use_gradient_align = getattr(options, 'gradient_align', False)
    
    if not use_gradient_align:
        raise ValueError("gradient_align must be True!")
    
    logging.info(f"Gradient alignment ENABLED with lambda={lambda_align}")
    
    # 统计
    total_batches_with_alignment = 0
    total_batches = 0
    
    for index, batch in enumerate(dataloader): 
        step = dataloader.num_batches * epoch + index
        scheduler(step)

        optimizer.zero_grad()
        total_loss = None
        penalty_loss = torch.tensor(0.0, device=options.device)
        alignment_loss_val = torch.tensor(0.0, device=options.device)
        cos_sim_val = 0.0
        batch_items = 0
        alignment_computed = False
        
        if options.sam:
            enable_running_stats(umodel)
            loss, contrastive_loss, constraint_loss, batch_items = compute_batch_loss(model, batch, criterion, options)
            
            align_result = compute_gradient_alignment_loss(model, batch, criterion, options)
            if align_result[0] is not None:
                alignment_loss_val, cos_sim_val = align_result
                loss = loss + lambda_align * alignment_loss_val
                alignment_computed = True
                total_batches_with_alignment += 1
            
            if regularizer is not None:
                penalty_loss = regularizer.penalty(model)
            total_loss = loss + penalty_loss
            total_loss.backward()
            optimizer.first_step(zero_grad = True)

            disable_running_stats(umodel)
            loss_second, _, _, _ = compute_batch_loss(model, batch, criterion, options)
            second_penalty = regularizer.penalty(model) if regularizer is not None else penalty_loss
            (loss_second + second_penalty).backward()
            optimizer.second_step(zero_grad = True)
        else:
            with autocast():
                loss, contrastive_loss, constraint_loss, batch_items = compute_batch_loss(model, batch, criterion, options)
                
                align_result = compute_gradient_alignment_loss(model, batch, criterion, options)
                if align_result[0] is not None:
                    alignment_loss_val, cos_sim_val = align_result
                    loss = loss + lambda_align * alignment_loss_val
                    alignment_computed = True
                    total_batches_with_alignment += 1
                
                if regularizer is not None:
                    penalty_loss = regularizer.penalty(model)
                total_loss = loss + penalty_loss
                scaler.scale(total_loss).backward()
                scaler.step(optimizer)
            scaler.update()

        total_batches += 1
        umodel.logit_scale.data = torch.clamp(umodel.logit_scale.data, 0, 4.6052)

        end = time.time()

        if(options.master and (((index + 1) % modulo == 0) or (index == dataloader.num_batches - 1))):
            num_samples = (index + 1) * batch_items * options.num_devices
            dataloader_num_samples = dataloader.num_samples

            display_loss = total_loss.item() if total_loss is not None else loss.item()
            align_str = f"🔥 Align: {alignment_loss_val.item():.4f} Cos: {cos_sim_val:.4f}" if alignment_computed else "⚪ Skip"
            logging.info(f"Train Epoch: {epoch:02d} [{num_samples}/{dataloader_num_samples} ({100.0 * (index + 1) / dataloader.num_batches:.0f}%)]\tLoss: {display_loss:.6f}\t{align_str}\tTime: {end - start:.3f}\tLR: {optimizer.param_groups[0]['lr']:.9f}")

            metrics = {
                "loss": display_loss,
                "contrastive_loss": contrastive_loss.item(),
                "constraint_loss": constraint_loss.item(),
                "ewc_penalty": penalty_loss.item(),
                "gradient_alignment_loss": alignment_loss_val.item() if alignment_computed else 0.0,
                "gradient_cos_sim": cos_sim_val,
                "alignment_batch_ratio": total_batches_with_alignment / total_batches,
                "time": end - start,
                "lr": optimizer.param_groups[0]["lr"],
            }
            if(options.wandb):
                for key, value in metrics.items():
                    wandb.log({f"train/{key}": value, "step": step})
        
            start = time.time()
    
    logging.info(f"Epoch {epoch} summary: {total_batches_with_alignment}/{total_batches} batches had gradient alignment ({100*total_batches_with_alignment/total_batches:.1f}%)")
